      "code": "#include \u003ciostream\u003e\n#include \u003ciomanip\u003e\n\nvoid printStats(const int* data, int n) {\n    int minValue = data[0];\n    int maxValue = data[0];\n    int sum = 0;\n    int positive = 0;\n\n    for (int i = 0; i \u003c n; i++) {\n        if (data[i] \u003c minValue) {\n            minValue = data[i];\n        }\n\n        if (data[i] \u003e maxValue) {\n            maxValue = data[i];\n        }\n\n        sum += data[i];\n\n        if (data[i] \u003e 0) {\n            positive++;\n        }\n    }\n\n    double average = static_cast\u003cdouble\u003e(sum) / n;\n\n    std::cout \u003c\u003c \"Min: \" \u003c\u003c minValue \u003c\u003c '\\n';\n    std::cout \u003c\u003c \"Max: \" \u003c\u003c maxValue \u003c\u003c '\\n';\n    std::cout \u003c\u003c \"Average: \" \u003c\u003c std::fixed \u003c\u003c std::setprecision(2) \u003c\u003c average \u003c\u003c '\\n';\n    std::cout \u003c\u003c \"Positive: \" \u003c\u003c positive \u003c\u003c '\\n';\n}\n\nint main() {\n    int n{};\n\n    if (!(std::cin \u003e\u003e n)) {\n        std::cout \u003c\u003c \"Input error\\n\";\n        return 1;\n    }\n\n    if (n \u003c 1 || n \u003e 100) {\n        std::cout \u003c\u003c \"Invalid size\\n\";\n        return 0;\n    }\n\n    int* data{new int[n]};\n\n    for (int i = 0; i \u003c n; i++) {\n        if (!(std::cin \u003e\u003e data[i])) {\n            std::cout \u003c\u003c \"Input error\\n\";\n            delete[] data;\n            return 1;\n        }\n\n        if (data[i] \u003c -1000 || data[i] \u003e 1000) {\n            std::cout \u003c\u003c \"Invalid value\\n\";\n            delete[] data;\n            return 0;\n        }\n    }\n\n    printStats(data, n);\n\n    delete[] data;\n\n    return 0;\n}",
